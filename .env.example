# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Mock Mode (default true for zero external dependency testing)
MOCK_MODE=true

# AI / Speech Providers (options: gemini, mock, browser)
LLM_PROVIDER=mock
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Gemini API Configuration (optional when in MOCK_MODE)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.0-flash

# Sarvam AI Speech Configuration (optional; fallback is browser Web Speech API)
# Get your API subscription key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v1
SARVAM_TTS_MODEL=bulbul:v1

# Frontend Configuration
VITE_API_URL=http://localhost:8000
